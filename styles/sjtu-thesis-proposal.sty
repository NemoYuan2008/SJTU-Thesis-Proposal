% --- 初始化正文格式 ---
\newcommand{\initbodyformat}{
    % 设置正文的字体：楷书、0.5倍段间距
    % 行距倍数 1.75 为与官方 word 版仔细比对后选取的经验值
    \kaishu
    \setlength{\parskip}{0.5\baselineskip}
    \linespread{1.75}\selectfont

    % 设置浮动体内的字体为楷书小四号字，与正文一致
    \makeatletter
    \appto{\@floatboxreset}{\kaishu\zihao{-4}}
    \makeatother
}

