%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SJTU Graduate Thesis Proposal Template Style File
% 上海交通大学研究生学位论文开题报告模板样式文件
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sjtu-thesis-proposal}[2026/01/23 SJTU Thesis Proposal Template]

% --- 宏包加载 ---
\RequirePackage{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage[style=gb7714-2015]{biblatex}
\RequirePackage{etoolbox}
\RequirePackage[hidelinks]{hyperref}

% --- 页面设置 ---
\geometry{
    top    = 2.5cm,
    bottom = 2.5cm,
    left   = 2.8cm,
    right  = 2.8cm,
}

% --- 字体设置 ---
\setmainfont{texgyretermes}[
    Extension      = .otf,
    UprightFont    = *-regular,
    BoldFont       = *-bold,
    ItalicFont     = *-italic,
    BoldItalicFont = *-bolditalic,
]

% --- 自定义命令 ---
% 定义"研究课题来源"表格里用到的勾和框
\newcommand*{\myunchecked}{$\square$\kern.65pt}  % 未打勾的方框
\newcommand*{\mychecked}{\checkmark}              % 打勾

% 重定义日期格式为 YYYY-MM-DD
\renewcommand{\today}{\the\year-\ifnum\month<10 0\fi\the\month-\ifnum\day<10 0\fi\the\day}

% --- 标题样式设置 ---
% 一级标题仿宋加粗、悬挂缩进
% 二级和三级标题楷书加粗，与正文字体一致
\ctexset{
    section = {
        name = {,、},     % 一级标题编号后的顿号
        aftername = {},   % 取消顿号后的间距
        format = \fangsong\bfseries\linespread{1.25}\selectfont,
        % 全设置为 0pt 是因为后面用了 \parskip
        beforeskip = 0pt,
        afterskip = 0pt,
    },
    subsection = {
        format = \kaishu\bfseries,
        beforeskip = 0pt,
        afterskip = 0pt,
    },
    subsubsection = {
        format = \kaishu\bfseries,
        beforeskip = 0pt,
        afterskip = 0pt,
    },
}

% --- 参考文献环境定义（整体左缩进2字符）---
\defbibenvironment{bibliography}
  {\list{\printtext[labelnumberwidth]{\printfield{labelprefix}\printfield{labelnumber}}}
     {\setlength{\labelwidth}{\labelnumberwidth}%
      \setlength{\leftmargin}{\labelwidth}%
      \addtolength{\leftmargin}{\labelsep}%
      \addtolength{\leftmargin}{2em}% 额外左缩进2字符
      \setlength{\itemsep}{\bibitemsep}%
      \setlength{\parsep}{\bibparsep}}}
  {\endlist}
  {\item}

% --- 列表样式设置 ---
\setlist{nosep}

