%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SJTU Master Mid-term Report Template Style File
% 上海交通大学硕士中期检查报告模板样式文件
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sjtu-mid-report}[2026/01/23 SJTU Mid-term Report Template]

% --- 宏包加载 ---
\RequirePackage{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{lastpage}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage[style=gb7714-2015]{biblatex}
\RequirePackage{etoolbox}
\RequirePackage[hidelinks]{hyperref}

% --- 页面设置（严格按照原模板）---
\geometry{
    top    = 2.1cm,
    bottom = 2.1cm,
    left   = 2cm,
    right  = 2cm,
}

% --- 字体设置 ---
\setmainfont{texgyretermes}[
    Extension      = .otf,
    UprightFont    = *-regular,
    BoldFont       = *-bold,
    ItalicFont     = *-italic,
    BoldItalicFont = *-bolditalic,
]

% --- 自定义命令 ---
% 定义"研究课题来源"表格里用到的勾和框
\newcommand*{\myunchecked}{$\square$\kern.65pt}  % 未打勾的方框
\newcommand*{\mychecked}{\checkmark}              % 打勾

% 重定义日期格式为 YYYY-MM-DD
\renewcommand{\today}{\the\year-\ifnum\month<10 0\fi\the\month-\ifnum\day<10 0\fi\the\day}

% --- 标题样式设置（严格按照原模板）---
\ctexset{
    section = {
        name = {,、},
        aftername = {},
        format = \fangsong\bfseries\linespread{1.25}\selectfont,
        beforeskip = 24bp,
        afterskip = 6bp,
    },
    subsection = {
        format = \kaishu\bfseries,
        beforeskip = 12bp,
        afterskip = 6bp,
    },
    subsubsection = {
        format = \kaishu\bfseries,
        beforeskip = 6bp,
        afterskip = 6bp,
    },
}

% --- 参考文献环境定义（整体左缩进2字符）---
\defbibenvironment{bibliography}
  {\list{\printtext[labelnumberwidth]{\printfield{labelprefix}\printfield{labelnumber}}}
     {\setlength{\labelwidth}{\labelnumberwidth}%
      \setlength{\leftmargin}{\labelwidth}%
      \addtolength{\leftmargin}{\labelsep}%
      \addtolength{\leftmargin}{2em}% 额外左缩进2字符
      \setlength{\itemsep}{\bibitemsep}%
      \setlength{\parsep}{\bibparsep}}}
  {\endlist}
  {\item}

% --- 列表样式设置 ---
\setlist{nosep}

